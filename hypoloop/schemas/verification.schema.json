{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "hypothesis_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "hypothesis_id",
          "summary"
        ]
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "method": {
            "type": "string",
            "description": "怎么测的"
          },
          "before": {
            "type": "string",
            "description": "改之前的具体读数"
          },
          "after": {
            "type": "string",
            "description": "改之后的具体读数"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supported",
              "refuted",
              "inconclusive"
            ]
          },
          "reasoning": {
            "type": "string"
          }
        },
        "required": [
          "hypothesis_id",
          "method",
          "before",
          "after",
          "verdict",
          "reasoning"
        ]
      }
    },
    "kept": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "保留下来的假设 id"
    },
    "reverted": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "被证伪并已回滚的假设 id"
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "corrections_addressed": {
      "type": "array",
      "description": "质疑者给的**每一条** corrections 都要在这里交代，一条不许漏。调用方会机械核对 id 的覆盖情况，漏了会被点名。",
      "items": {
        "type": "object",
        "properties": {
          "correction_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "applied",
              "rejected",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string",
            "description": "applied：写清代码里最终的实际取值，以及支持它的读数。rejected：拿读数说明为什么质疑者也不对 —— 「我觉得不用」不算理由。not_applicable：说清这条为什么落空了（比如整条假设已被证伪并回滚）"
          }
        },
        "required": [
          "correction_id",
          "action",
          "evidence"
        ]
      }
    },
    "goal": {
      "type": "object",
      "description": "**只有调用方给了结束条件时才需要填。** 没给就整个省略这个字段。\n填了的话，met 是你对「这个条件是否已经达成」的判断，evidence 必须是**你这一轮真的测出来的读数**，能让人照着复核。\n注意：met=true 会让调用方**跳过剩下所有轮次**。判不准、证据不足、只测了一部分 —— 一律填 false。**多跑一轮只是费点 token，错误地提前收工会把没验完的改动留在仓库里。**",
      "properties": {
        "met": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "description": "支持这个判断的具体读数。met=true 时必须逐项对上结束条件里的每一个要求；met=false 时写清还差什么"
        }
      },
      "required": [
        "met",
        "evidence"
      ]
    }
  },
  "required": [
    "summary",
    "changes",
    "evidence",
    "kept",
    "reverted",
    "open_questions",
    "corrections_addressed"
  ]
}
